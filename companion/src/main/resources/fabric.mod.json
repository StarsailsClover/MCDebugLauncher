    "repo": "https://github.com/StarsailsClover/MCDebugLauncher"
  },
  "license": "Apache-2.0",
  "icon": "",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.mdl.companion.MdlCompanionMod"
    ]
  },
  "mixins": [
    "mdl-agent-companion.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21.4",
    "java": ">=21"
  }
}
