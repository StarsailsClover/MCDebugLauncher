# Rust build artifacts
/target
# NOTE: Cargo.lock IS tracked on purpose. mdl is a binary crate; the lock
# file gives reproducible release builds and CI runs with --locked.

# Packaged release artifacts
/release

# Development files
*.log
*.output
build_output.txt
build.log

# Test files
test_*.py
test_*.js

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Claude Code workspace
.claude/
SOUL.md
USER.md
memory/

# Examples and documentation drafts
forge-*.log
launch.log

# Session migration data (Cherry Studio)
.cherry_migration/

# Agent session data (Qwen / other AI tools)
.qwen-agent-sessions/

# AI tool session data (OpenCode / Trae)
.opencode-data/
.trae/

# Release zip artifacts (built, not committed)
mdl-v26*-windows-x64.zip
mdl-v26*-windows-x64/

# Documentation files (release notes; CHANGELOG.md is NOT ignored - it is
# include_str!'d into the binary at src/util/changelog.rs and must be tracked)
RELEASE_NOTES*.md

# Installer logs (NeoForge/Forge)
neoforge-*-installer.jar.log

# Misc build/test artifacts
release_build.log
build_output.txt

# Fuzzing (cargo-fuzz workspace under fuzz/)
fuzz/target
fuzz/corpus
fuzz/artifacts
fuzz/coverage
fuzz/crash-*
fuzz/fuzz_targets/*.rs.orig


# Host-specific performance baseline (scripts/perf-bench.ps1 -SaveBaseline)
perf-baseline.json
